---
import { getCollection, render } from 'astro:content'
import getReadingTime from 'reading-time'
import fs from 'node:fs'
import BaseLayout from '../../layouts/BaseLayout.astro'
import '../../styles/blog.css'

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.isDraft !== true)
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
const minutes = Math.ceil(getReadingTime(post.body ?? '').minutes)

// 封面图(由 qwen-image 生成,public/assets/covers/ 下,缺失则跳过)
const cover = `/assets/covers/${post.id}.png`
const hasCover = fs.existsSync(new URL(`../../public/assets/covers/${post.id}.png`, import.meta.url))

const title = `${post.data.title} | LUNA`
const description = post.data.description ?? post.data.title
const fmt = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })
---

<BaseLayout
  title={title}
  description={description}
  pageType="article"
  image={hasCover ? cover : undefined}
>
  <div class="blog-shell">
    <header class="blog-nav">
      <a class="blog-nav__brand" href="/">LUNA<sup>01</sup></a>
      <nav class="blog-nav__links" aria-label="Primary navigation">
        <a href="/#cases">Cases</a>
        <a href="/#blocks">Blocks</a>
        <a href="/#playgrounds">Playgrounds</a>
        <a href="/posts">Posts</a>
      </nav>
    </header>

    <main class="blog-frame">
      <a class="blog-article__back" href="/posts">&larr; 返回列表</a>

      <article>
        <header>
          <p class="blog-article__eyebrow">数据逆向 / Teardown</p>
          <h1 class="blog-article__title">{post.data.title}</h1>
          <div class="blog-article__meta">
            <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
            {minutes > 0 && <span>· {minutes} 分钟阅读</span>}
            {post.data.tags.length > 0 && (
              <ul class="blog-article__tags">
                {post.data.tags.map((tag) => (
                  <li><span>{tag}</span></li>
                ))}
              </ul>
            )}
          </div>
        </header>

        {hasCover && <img class="blog-article__cover" src={cover} alt="" width="2752" height="1536" />}

        <div class="blog-article__body">
          <Content />
        </div>
      </article>

      <footer class="blog-footer">
        <span>前端逆向 × 数据逆向 · 研究好东西是怎么做出来的</span>
        <a href="/posts">返回列表</a>
      </footer>
    </main>
  </div>
</BaseLayout>
