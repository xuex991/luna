---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import '../../styles/blog.css'

const posts = (await getCollection('posts', ({ data }) => data.isDraft !== true)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)

const description = '数据逆向：拆解 X 上的工程 claim，拉取数据验证，给出可证伪的结论。'
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })
---

<BaseLayout title="Posts | LUNA" description={description}>
  <div class="blog-shell">
    <main class="blog-shell-split">
      <section class="blog-primary">
        <h1 class="blog-site-title"><a href="/">LUNA</a></h1>
        <p class="blog-bio">拆解 X 上的工程 claim，拉公开数据验证，给出可证伪的结论。把优秀的东西拆开，看它是怎么做出来的。</p>

        <section class="blog-index" aria-labelledby="posts-heading">
          <h2 id="posts-heading">Posts</h2>
          <div class="blog-list">
            {posts.map((post) => (
              <a class="blog-row" href={`/posts/${post.id}`}>
                <span>{post.data.title}</span>
                <time datetime={post.data.pubDate.toISOString().slice(0, 7)}>{fmt(post.data.pubDate)}</time>
              </a>
            ))}
          </div>
        </section>
      </section>

      <aside class="blog-side">
        <img src="/assets/visuals/teardown-side.jpg" alt="" width="934" height="1600" />
      </aside>
    </main>
  </div>
</BaseLayout>
